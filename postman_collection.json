{
  "info": {
    "name": "MiniOpenCode API",
    "description": "AI Agent 流式对话服务",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "om_fixed_api_key_12345" }
  ],
  "item": [
    {
      "name": "健康检查",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Chat - 流式对话",
      "item": [
        {
          "name": "POST /api/web/chat/stream (无工具-单轮)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/web/chat/stream", "host": ["{{baseUrl}}"], "path": ["api", "web", "chat", "stream"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"messages\": [{\"role\": \"user\", \"content\": \"你好，2+2等于几\"}],\n  \"system\": \"你是助手\",\n  \"useTools\": false\n}" }
          }
        },
        {
          "name": "POST /api/web/chat/stream (有工具-单轮)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/web/chat/stream", "host": ["{{baseUrl}}"], "path": ["api", "web", "chat", "stream"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"messages\": [{\"role\": \"user\", \"content\": \"深圳天气怎么样\"}],\n  \"system\": \"你是助手，可以调用工具\",\n  \"useTools\": true\n}" }
          }
        },
        {
          "name": "POST /api/web/chat/stream (多轮对话-携带sessionId)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/web/chat/stream", "host": ["{{baseUrl}}"], "path": ["api", "web", "chat", "stream"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"test_session_001\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"深圳天气怎么样\"}],\n  \"system\": \"你是助手，可以调用工具\",\n  \"useTools\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Session - 会话管理",
      "item": [
        {
          "name": "GET /api/web/sessions (获取所有会话)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/web/sessions", "host": ["{{baseUrl}}"], "path": ["api", "web", "sessions"] },
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ]
          }
        },
        {
          "name": "GET /api/web/chat/session/:sessionId (获取单个会话)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/web/chat/session/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "web", "chat", "session", ":sessionId"],
              "variable": [{ "key": "sessionId", "value": "test_session_001" }]
            },
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ]
          }
        },
        {
          "name": "DELETE /api/web/chat/session/:sessionId (删除会话)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/web/chat/session/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "web", "chat", "session", ":sessionId"],
              "variable": [{ "key": "sessionId", "value": "test_session_001" }]
            },
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ]
          }
        }
      ]
    }
  ]
}
