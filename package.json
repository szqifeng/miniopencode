{
  "name": "miniopencode",
  "version": "1.0.0",
  "description": "AI Agent 服务，支持多轮对话和工具调用的流式对话",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "ui:build": "cd src/ui && npm run build && cp renderer/*.html ../../dist-ui/renderer/",
    "ui:dev": "npm run ui:build && ./src/ui/node_modules/.bin/electron dist-ui --no-sandbox",
    "ui:start": "./src/ui/node_modules/.bin/electron dist-ui --no-sandbox",
    "ui:stop": "pkill -f electron || true"
  },
  "keywords": [
    "ai",
    "agent",
    "chatbot",
    "llm",
    "anthropic",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szqifeng/miniopencode.git"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@anthropic-ai/sdk": "^0.30.0",
    "ai": "^6.0.134",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
