{
  "name": "miniopencode",
  "version": "1.0.0",
  "description": "AI Agent 服务，支持多轮对话和工具调用的流式对话",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "build:server": "tsc -p tsconfig.json --outDir dist-server --declaration false --sourceMap false",
    "build:ui": "npm --prefix src/ui/task-scheduler-vite run build",
    "build:desktop": "npm run build:server && npm run build:ui",
    "desktop:preview": "npm run build:desktop && electron desktop/main.mjs",
    "desktop:dev": "npm run build:server && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron desktop/main.mjs",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "cd src/ui && npm run build && cp renderer/*.html ../../dist-ui/renderer/",
    "ui:dev": "npm run ui:build && ./src/ui/node_modules/.bin/electron dist-ui --no-sandbox",
    "ui:start": "./src/ui/node_modules/.bin/electron dist-ui --no-sandbox",
    "ui:stop": "pkill -f electron || true"
  },
  "keywords": [
    "ai",
    "agent",
    "chatbot",
    "llm",
    "anthropic",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szqifeng/miniopencode.git"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@anthropic-ai/sdk": "^0.30.0",
    "ai": "^6.0.134",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "zod": "^4.3.6",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "node-fetch": "^3.3.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.szqifeng.miniopencode",
    "productName": "MiniOpenCode",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist-server/**/*",
      "prompts/**/*",
      "src/ui/task-scheduler-vite/dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
